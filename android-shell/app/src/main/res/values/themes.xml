<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight so the WebView's own dark styling and the system chrome agree. -->
    <style name="Theme.ZcodeRemote" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <!-- 不设 statusBarColor / navigationBarColor：targetSdk 35 的
             edge-to-edge 下它们会被忽略，系统栏区域显示的是 windowBackground，
             而 inset 由 enableLightEdgeToEdge/padForSystemBars 处理。 -->
    </style>

    <!-- Shown while the process starts, before the WebView has anything to
         paint: a flat background avoids a white/black flash. -->
    <style name="Theme.ZcodeRemote.Splash" parent="Theme.ZcodeRemote">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>
</resources>
