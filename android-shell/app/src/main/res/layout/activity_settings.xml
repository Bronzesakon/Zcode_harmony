<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页，按 MiuiX 设计语言重排（规格与取值来源见 values/miuix_styles.xml）。

     结构：SmallTopAppBar（返回箭头 + 标题）→ 可滚动区，区内每个小节一段
     SmallTitle（14sp Bold、onBackgroundVariant）+ 一张 Card（16dp 圆角、
     surfaceContainer 底色、左右 12dp），卡片里是若干 BasicComponent 行
     （标题 17sp Medium + 摘要 14sp summary 色，行尾箭头 10x16dp actions 色），
     行与行之间是 0.75dp 的 dividerLine 分隔线。

     没有用 MaterialCardView / 主题色角色：MiuiX 的取色表已经逐项落在
     @color/miuix_* 上，这里直接引用，避免同一页出现两套蓝。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/MiuixPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/MiuixAppBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/MiuixAppBarIcon"
            android:src="@drawable/ic_back"
            app:tint="@color/miuix_on_background" />

        <TextView
            style="@style/MiuixAppBarTitle"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ===== 连接 ===== -->
            <TextView
                style="@style/MiuixSection"
                android:text="@string/settings_section_connection" />

            <LinearLayout style="@style/MiuixCard">

                <LinearLayout style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_current_url" />

                        <TextView
                            android:id="@+id/currentUrl"
                            style="@style/MiuixRowSummary"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/MiuixDivider" />

                <LinearLayout
                    android:id="@+id/rowChangeUrl"
                    style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_change_url" />

                        <TextView
                            style="@style/MiuixRowSummary"
                            android:text="@string/settings_change_url_hint" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>

                <View style="@style/MiuixDivider" />

                <LinearLayout
                    android:id="@+id/rowReloadWeb"
                    style="@style/MiuixRow">

                    <TextView
                        style="@style/MiuixRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_reload" />

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 通知 ===== -->
            <TextView
                style="@style/MiuixSection"
                android:text="@string/settings_section_notifications" />

            <LinearLayout style="@style/MiuixCard">

                <LinearLayout
                    android:id="@+id/rowNotificationPermission"
                    style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_notification_permission" />

                        <TextView
                            android:id="@+id/notificationPermissionState"
                            style="@style/MiuixRowSummary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>

                <View style="@style/MiuixDivider" />

                <LinearLayout
                    android:id="@+id/rowClearNotifications"
                    style="@style/MiuixRow">

                    <TextView
                        style="@style/MiuixRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_clear_notifications" />

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 后台保活 ===== -->
            <TextView
                style="@style/MiuixSection"
                android:text="@string/settings_section_keepalive" />

            <LinearLayout style="@style/MiuixCard">

                <LinearLayout
                    android:id="@+id/rowBattery"
                    style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_battery_optimization" />

                        <TextView
                            android:id="@+id/batteryState"
                            style="@style/MiuixRowSummary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 高级 ===== -->
            <TextView
                style="@style/MiuixSection"
                android:text="@string/settings_section_advanced" />

            <LinearLayout style="@style/MiuixCard">

                <LinearLayout
                    android:id="@+id/rowSubscribeAll"
                    style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_subscribe_all" />

                        <TextView
                            android:id="@+id/subscribeAllState"
                            style="@style/MiuixRowSummary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSubscribeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/settings_subscribe_all" />
                </LinearLayout>

                <View style="@style/MiuixDivider" />

                <LinearLayout
                    android:id="@+id/rowDiagnostics"
                    style="@style/MiuixRow">

                    <TextView
                        style="@style/MiuixRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_inject_diagnostics" />

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>

                <View style="@style/MiuixDivider" />

                <LinearLayout
                    android:id="@+id/rowShareLog"
                    style="@style/MiuixRow">

                    <TextView
                        style="@style/MiuixRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_share_log" />

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>

                <View style="@style/MiuixDivider" />

                <LinearLayout
                    android:id="@+id/rowClearDiagnostics"
                    style="@style/MiuixRow">

                    <TextView
                        style="@style/MiuixRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_clear_diagnostics" />

                    <ImageView
                        style="@style/MiuixRowChevron"
                        app:tint="@color/miuix_on_surface_actions" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 诊断（真机调试） ===== -->
            <TextView
                style="@style/MiuixSection"
                android:text="@string/settings_section_diagnostics" />

            <LinearLayout style="@style/MiuixCard">

                <LinearLayout style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_survival" />

                        <TextView
                            android:id="@+id/survivalText"
                            style="@style/MiuixRowSummary"
                            android:text="@string/settings_survival_loading" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 关于 ===== -->
            <TextView
                style="@style/MiuixSection"
                android:text="@string/settings_section_about" />

            <LinearLayout style="@style/MiuixCard">

                <LinearLayout style="@style/MiuixRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/MiuixRowTitle"
                            android:text="@string/settings_version" />

                        <TextView
                            android:id="@+id/versionText"
                            style="@style/MiuixRowSummary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
