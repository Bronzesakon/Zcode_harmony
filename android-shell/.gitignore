# Gradle / Android build outputs
build/
.gradle/
local.properties

# 本地签名材料（keystore、密码、base64 取值来源）— 仅本地保留
scratch/

# Release signing material — NEVER commit these.
# CI writes key.properties from GitHub Secrets; locally you create it by hand
# (see key.properties.example).
key.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
captures/

# Node-based protocol tests (tools/) keep no build output, but be explicit so a
# stray npm artefact can never reach the repo.
node_modules/

