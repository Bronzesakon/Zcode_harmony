<?xml version="1.0" encoding="utf-8"?>
<!-- MiuixAppBarTitle / MiuixRowTitle 的 API 28+ 版本。

     android:textFontWeight（字重 Medium = 500）是 API 28 才有的框架属性。写在
     values/ 里会让 lint 的 NewApi 报错，且 26/27 上本来也会被静默忽略；所以整条
     样式挪到 values-v28 覆盖，26/27 落回 values/ 的那份（常规字重，可接受的降级）。

     注意 Android 的样式资源是"整个替换"而不是合并：同名 <style> 在限定目录里出现
     时，会整体取代 values/ 里的那份，不会做 items 合并。因此这里必须把
     values/miuix_styles.xml 中同名样式的每一条 item 原样抄全，只多出
     android:textFontWeight 这一条。少抄一条 = 新设备上静默丢掉一条样式，
     比 lint 报错更糟。 -->
<resources xmlns:app="http://schemas.android.com/apk/res-auto">

    <style name="MiuixAppBarTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">@dimen/miuix_appbar_title_padding</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/miuix_on_surface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="MiuixRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/miuix_on_background</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
</resources>
