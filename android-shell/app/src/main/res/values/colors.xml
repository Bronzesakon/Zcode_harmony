<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the HarmonyOS build's fixed light palette (its status-bar colour
         is #F8F8F8), so the two shells look like one product. -->
    <color name="brand_background">#FFF8F8F8</color>
    <color name="brand_surface">#FFFFFFFF</color>
    <color name="brand_on_surface">#FF1B1B1F</color>
    <color name="brand_on_surface_variant">#FF6B6B72</color>
    <color name="brand_primary">#FF1F6FEB</color>
    <color name="brand_outline">#FFE2E2E6</color>
    <color name="brand_error">#FFB3261E</color>

    <!-- Legacy bitmap fallback (mipmap-xxxhdpi/ic_launcher.png) carries the same
         artwork flattened; the adaptive background layer is pure black because
         background.png in the HarmonyOS icon is pure black. -->
    <color name="ic_launcher_background">#FF000000</color>
</resources>
